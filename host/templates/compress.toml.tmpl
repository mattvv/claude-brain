# claude-brain compression config.
# Managed by `brain compress`. Kill switch: `brain compress off` or
# `touch $BRAIN_STATE_DIR/compress/DISABLED` (works even if this file is bad).
version = 1

# Master switch for the subsystem. When false, brain-ask behaves exactly like
# the legacy Bash implementation and records nothing.
enabled = true

[artifacts]
# Content-addressed raw-artifact store, so a future lossy view always has an
# exact recoverable source (`brain compress show <id> --full`).
quota_bytes = 536870912   # 512 MiB
default_ttl_days = 30
content_addressed = true

[accounting]
# Byte->token estimate is ALWAYS labelled an estimate; provider-reported usage is
# the ground truth for consultations. Dollars are never printed.
estimated_bytes_per_token = 4.0
print_dollars = false
# Suppress measured-savings percentages until this many compressed samples exist.
minimum_claim_samples = 30

[ledger]
format = "jsonl"
hourly_rollups = true

[retention]
# Newest N consult logs kept under $BRAIN_STATE_DIR/consult (matches legacy).
consult_logs = 20

[file_tools]
# `brain compress read/grep/tree` are always available. The Read guard controls
# what happens when the model reads a large file whole:
#   observe (default) — record it for `brain compress discover`, change nothing
#   enforce           — deny it with guidance to use `brain compress read`
#   off               — no guard
read_guard = "observe"
large_file_lines = 800
large_file_bytes = 49152
# Smallest command output worth compacting. Below this a lossy view saves less
# than recovering the original would cost.
compress_min_bytes = 2048
# Exact, byte-for-byte lines kept at the head of a compacted file read
# (cat/head/tail/sed -n). The omitted remainder is mapped by signature with real
# line numbers, and the full text stays recoverable.
bash_read_head_lines = 60

[explore]
# `brain explore "QUESTION"` navigates the repo with a cheap model so the main
# brain never reads files to orient itself. `models` is an ordered FALLBACK
# CHAIN: explore tries each in turn and falls to the next when a model's vendor
# isn't linked or the call fails. Must be non-Claude models. `brain explore
# --model M` overrides the chain for a single run.
models = "gpt-5.6-luna,grok-4.5"
effort = "low"
max_pack_bytes = 98304
