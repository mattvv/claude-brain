#!/usr/bin/env bash
# claude-brain droplet CLI.
#
#   brain            attach/create the Remote Control session (default)
#   brain repo add X clone a GitHub repo and serve phone sessions for it
#                    (also: repo ls | repo serve <name> | repo stop <name>)
#   brain multi      parable-style multi-model session (no Remote Control)
#   brain status     health overview: host, proxy, logins, sessions
#   brain autostart  come back automatically after a reboot (enable|disable|status)
#   brain keepawake  stop this machine from sleeping (shows what it will change)
#   brain expose P   share a dev server on port P (tailnet HTTPS; --public
#                    for a world-reachable Funnel URL; 'off' to stop)
#   brain auth X     (re)run a login: anthropic|chatgpt|grok|kimi|claude|github
#   brain auth start|paste|check X   drive a login non-interactively (for
#                    Claude sessions / remote use — see brain-ops.md)
#   brain setup      first-time onboarding wizard (resumable)
#   brain config     settings: consult foreground|background (watch brain-*
#                    consultants work live, or run them in the background)
#   brain consult    live consultation progress: status | log | watch
#   brain update     pull latest claude-brain + rebuild what changed
#   brain uninstall  remove claude-brain and restore your Claude Code config
#                    (--purge also deletes state and linked credentials)
#   brain help       this text

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

AGENTS_DIR="$HOME/.claude/agents"
AGENTS_RC_SRC="$BRAIN_REPO_DIR/host/claude/agents-rc"
AGENTS_MULTI_SRC="$BRAIN_REPO_DIR/host/claude/agents-multi"

# Names covered by both lanes; installing one lane removes the other's copies.
ALL_BRAIN_AGENTS=(brain-fable brain-grok brain-kimi brain-luna brain-sol brain-terra)

install_agents() {
  local src="$1" name f
  mkdir -p "$AGENTS_DIR"
  for name in "${ALL_BRAIN_AGENTS[@]}"; do
    rm -f "$AGENTS_DIR/$name.md"
  done
  for f in "$src"/*.md; do
    cp "$f" "$AGENTS_DIR/$(basename "$f")"
  done
}

# Install a managed block into ~/.claude/CLAUDE.md, replacing any previous copy.
install_block() {
  local src="$1" label="$2" target="$HOME/.claude/CLAUDE.md" tmp
  local start="<!-- claude-brain:$label:start -->" end="<!-- claude-brain:$label:end -->"
  mkdir -p "$HOME/.claude"
  tmp="$(mktemp)"
  if [ -f "$target" ]; then
    awk -v s="$start" -v e="$end" '$0==s{skip=1} !skip{print} $0==e{skip=0}' "$target" > "$tmp"
  fi
  { printf '%s\n' "$start"; cat "$src"; printf '%s\n' "$end"; } >> "$tmp"
  mv "$tmp" "$target"
}

# Drop a managed block from ~/.claude/CLAUDE.md, leaving the user's own text.
remove_block() {
  local label="$1" target="$HOME/.claude/CLAUDE.md" tmp
  local start="<!-- claude-brain:$label:start -->" end="<!-- claude-brain:$label:end -->"
  [ -f "$target" ] || return 0
  tmp="$(mktemp)"
  awk -v s="$start" -v e="$end" '$0==s{skip=1} !skip{print} $0==e{skip=0}' "$target" > "$tmp"
  mv "$tmp" "$target"
}

install_routing() {
  install_block "$1" routing
  install_ops_block
  install_consult_block
}

# The ops instructions differ by machine, not by taste: on a droplet the brain
# administers a disposable VM with passwordless sudo; on someone's own Mac or
# Linux box it must ask before changing the machine, may hit a password prompt
# it cannot answer, and may be confined to a workspace.
install_ops_block() {
  local profile scope src tmp scope_note sudo_note pkg_hint hostdesc
  profile="$(setting_get PROFILE "$(default_profile)")"
  if [ "$profile" = droplet ]; then
    install_block "$BRAIN_REPO_DIR/host/claude/brain-ops-droplet.md" ops
    return
  fi
  scope="$(setting_get SCOPE machine)"
  if [ "$scope" = workspace ]; then
    scope_note="**Stay in your workspace.** Your working root is \`$(workspace_dir)\`. Work
there by default, and ask before reading or writing the user's files elsewhere on this
machine."
  else
    scope_note="**Scope: the whole machine.** The user chose to give you the run of this
computer, so you may work anywhere in their home directory — but it is still their daily
machine, so destructive or wide-reaching changes get confirmed first."
  fi
  case "$(sudo_mode)" in
    passwordless) sudo_note="Sudo works without a password here, so use it sparingly and say what you ran." ;;
    prompt)       sudo_note="Sudo will ask for a password you do not have, so a sudo command will hang or fail — hand it to the user instead." ;;
    *)            sudo_note="There is no sudo on this machine — anything needing privileges has to be done by the user." ;;
  esac
  case "$(pkg_manager)" in
    brew)   pkg_hint="brew install <pkg>" ;;
    pacman) pkg_hint="sudo pacman -S <pkg>" ;;
    apt)    pkg_hint="sudo apt-get install -y <pkg>" ;;
    dnf)    pkg_hint="sudo dnf install -y <pkg>" ;;
    *)      pkg_hint="no package manager detected — ask the user" ;;
  esac
  hostdesc="$(brain_distro) · $(brain_os)/$(brain_arch)"
  src="$BRAIN_REPO_DIR/host/claude/brain-ops-local.md"
  tmp="$(mktemp)"
  awk -v note="$scope_note" '{ if ($0 == "__SCOPE_NOTE__") print note; else print }' "$src" \
    | sed -e "s|__SUDO_NOTE__|$sudo_note|" \
          -e "s|__PKG_HINT__|$pkg_hint|" \
          -e "s|__HOSTDESC__|$hostdesc|" > "$tmp"
  install_block "$tmp" ops
  rm -f "$tmp"
}

# Where the brain works by default. Whole-machine scope keeps the historical
# ~/workspace; workspace scope gets its own root, chosen at setup.
workspace_dir() {
  setting_get WORKSPACE_DIR "$HOME/workspace"
}

# Consultant visibility: background (default — visible via the statusline and
# the consult stream log) or foreground (consult inline in the main chat).
# Chosen via 'brain config consult', applied as a CLAUDE.md block.
install_consult_block() {
  local mode
  mode="$(setting_get CONSULT_VISIBILITY background)"
  install_block "$BRAIN_REPO_DIR/host/claude/consult-$mode.md" consult
}

step_done() { printf '  %s %s\n' "${C_GREEN}[done]${C_RESET}" "$1"; }
step_todo() { printf '  %s %s\n' "${C_YELLOW}[    ]${C_RESET}" "$1"; }

# Check for a newer claude-brain at session launch; prompt to install.
# Silent and non-blocking on network trouble.
check_for_updates() {
  [ -t 0 ] || return 0
  run_timeout 8 git -C "$BRAIN_REPO_DIR" fetch --quiet origin main 2>/dev/null || return 0
  local behind
  behind="$(git -C "$BRAIN_REPO_DIR" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
  [ "$behind" -gt 0 ] || return 0
  warn "a claude-brain update is available ($behind new change$([ "$behind" -gt 1 ] && echo s))"
  if ask_yn "Install it now?"; then
    cmd_update
  fi
}

# ---------------------------------------------------------------- rc session
REPOS_DIR="$HOME/repos"

# The RC server refuses untrusted (and home) directories; pre-accept the
# workspace trust dialog for a project directory.
seed_trust() {
  local dir="$1"
  [ -s "$HOME/.claude.json" ] || echo '{}' > "$HOME/.claude.json"
  jq --arg d "$dir" '.projects[$d] = ((.projects[$d] // {}) + {hasTrustDialogAccepted: true})' \
    "$HOME/.claude.json" > "$HOME/.claude.json.tmp" && mv "$HOME/.claude.json.tmp" "$HOME/.claude.json"
}

# Start (or attach to) a persistent Remote Control server for a directory.
# Sessions spawn on demand from the Claude app / claude.ai/code (capacity 32).
# RC needs api.anthropic.com, so any proxy override is scrubbed.
rc_server() {
  local dir="$1" tmux_name="$2" prefix="$3"
  need tmux jq
  claude_bin >/dev/null || die "claude not installed — run: brain setup"
  install_agents "$AGENTS_RC_SRC"
  install_routing "$BRAIN_REPO_DIR/host/claude/routing-rc.md"
  seed_trust "$dir"
  if ! tmux has-session -t "$tmux_name" 2>/dev/null; then
    info "starting Remote Control server for $dir (tmux: $tmux_name)"
    info "open the Claude app (Code tab) or claude.ai/code to start sessions there"
  fi
  local launch
  launch="cd '$dir' && env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_API_KEY \
    $(claude_bin) remote-control --spawn same-dir --remote-control-session-name-prefix '$prefix'; exec bash"
  if [ -t 0 ]; then
    exec tmux new-session -A -s "$tmux_name" "$launch"
  else
    # No terminal (e.g. invoked by a Claude session): run the server detached.
    tmux has-session -t "$tmux_name" 2>/dev/null || tmux new-session -d -s "$tmux_name" "$launch"
    ok "server running detached (attach later: tmux attach -t $tmux_name)"
  fi
}

cmd_rc() {
  local ws
  ws="$(workspace_dir)"
  check_for_updates
  mkdir -p "$ws"
  git -C "$ws" rev-parse --git-dir >/dev/null 2>&1 || git -C "$ws" init -q
  rc_server "$ws" brain-rc brain
}

# -------------------------------------------------------------------- repos
# Each repo gets its own Remote Control server, so the phone/claude.ai shows
# per-repo places to start sessions.
cmd_repo() {
  local sub="${1:-ls}" arg="${2:-}"
  case "$sub" in
    add)
      [ -n "$arg" ] || die "usage: brain repo add <owner/name | git-url> [name]"
      need git jq
      local name="${3:-}"
      [ -n "$name" ] || { name="${arg##*/}"; name="${name%.git}"; }
      mkdir -p "$REPOS_DIR"
      local dir="$REPOS_DIR/$name"
      if [ ! -d "$dir" ]; then
        info "cloning $arg into $dir"
        if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
          gh repo clone "$arg" "$dir"
        else
          git clone "$arg" "$dir"
        fi
      else
        step_done "already cloned: $dir"
      fi
      rc_server "$dir" "brain-rc-$name" "$name"
      ;;
    serve)
      [ -n "$arg" ] || die "usage: brain repo serve <name>"
      [ -d "$REPOS_DIR/$arg" ] || die "no such repo: $REPOS_DIR/$arg (see: brain repo ls)"
      rc_server "$REPOS_DIR/$arg" "brain-rc-$arg" "$arg"
      ;;
    stop)
      [ -n "$arg" ] || die "usage: brain repo stop <name>"
      tmux kill-session -t "brain-rc-$arg" 2>/dev/null \
        && ok "stopped server for $arg" || warn "no server running for $arg"
      ;;
    ls)
      local d name
      printf '%s\n' "${C_BOLD}repos${C_RESET}"
      for d in "$REPOS_DIR"/*/; do
        [ -d "$d" ] || { warn "none yet — add one: brain repo add <owner/name>"; return 0; }
        name="$(basename "$d")"
        if tmux has-session -t "brain-rc-$name" 2>/dev/null; then
          ok "$name (serving — sessions available in the app)"
        else
          step_todo "$name (stopped — start: brain repo serve $name)"
        fi
      done
      ;;
    *)
      die "usage: brain repo <add|serve|stop|ls>"
      ;;
  esac
}

# ------------------------------------------------------------- multi session
cmd_multi() {
  need tmux
  claude_bin >/dev/null || die "claude not installed — run: brain setup"
  proxy_ready || die "proxy is not healthy — check: brain status"
  check_for_updates
  install_agents "$AGENTS_MULTI_SRC"
  install_routing "$BRAIN_REPO_DIR/host/claude/routing-multi.md"
  local token
  token="$(brain_token)"
  info "starting multi-model session (tmux: brain-multi) — no phone control in this mode"
  # 372000 = smallest context window across the cast (gpt-5.6-* models).
  exec tmux new-session -A -s brain-multi \
    "env -u ANTHROPIC_API_KEY -u CLAUDE_CODE_OAUTH_TOKEN \
       ANTHROPIC_BASE_URL=$BRAIN_PROXY_URL \
       ANTHROPIC_AUTH_TOKEN=$token \
       CLAUDE_CODE_MAX_CONTEXT_TOKENS=372000 \
       $(claude_bin) --model 'claude-fable-5[1m]'; exec bash"
}

# ------------------------------------------------------------------- status
cmd_status() {
  need curl jq
  printf '%s\n' "${C_BOLD}claude-brain status${C_RESET}"
  printf '    host: %s · %s/%s · profile=%s · scope=%s\n' \
    "$(brain_distro)" "$(brain_os)" "$(brain_arch)" \
    "$(setting_get PROFILE "$(default_profile)")" "$(setting_get SCOPE machine)"

  if svc_is_active proxy; then
    ok "proxy service: running"
  else
    fail "proxy service: not running (restart: $(svc_restart_hint proxy))"
  fi

  if proxy_ready; then
    ok "proxy API: healthy on $BRAIN_PROXY_URL"
    printf '    models: %s\n' "$(proxy_models | paste -sd', ' -)"
  else
    fail "proxy API: not responding on $BRAIN_PROXY_URL"
  fi

  if listening_publicly "$BRAIN_PROXY_PORT"; then
    fail "SECURITY: proxy is listening on a public interface — it must be 127.0.0.1 only"
  fi

  printf '%s\n' "${C_BOLD}linked accounts (proxy vendors)${C_RESET}"
  local found=0 f
  for f in "$BRAIN_AUTH_DIR"/*.json; do
    [ -e "$f" ] || continue
    found=1
    ok "$(basename "$f" .json)"
  done
  [ "$found" -eq 1 ] || warn "none yet — run: brain auth chatgpt|grok|kimi"

  printf '%s\n' "${C_BOLD}claude & github${C_RESET}"
  if claude_bin >/dev/null; then
    ok "claude installed: $("$(claude_bin)" --version 2>/dev/null | head -1)"
  else
    fail "claude not installed"
  fi
  if [ -e "$HOME/.claude/.credentials.json" ] || [ -s "$HOME/.claude.json" ]; then
    ok "claude login present (verify inside a session with /status)"
  else
    warn "no claude login yet — run: brain auth anthropic"
  fi
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    ok "github: logged in"
  else
    warn "github: not logged in — run: brain auth github"
  fi

  printf '%s\n' "${C_BOLD}tailscale${C_RESET}"
  if ts="$(tailscale_bin)" && "$ts" status >/dev/null 2>&1; then
    ok "connected: $("$ts" status --json | jq -r '.Self.DNSName' | sed 's/\.$//')"
  else
    step_todo "not connected (optional — brain auth tailscale enables 'brain expose')"
  fi

  printf '%s\n' "${C_BOLD}always on${C_RESET}"
  printf '    %s\n' "$(autostart_status | head -1)"
  printf '    %s\n' "$(keepawake_status)"

  printf '%s\n' "${C_BOLD}sessions${C_RESET}"
  if tmux has-session -t brain-rc 2>/dev/null; then
    ok "brain-rc running (attach: brain)"
  else
    step_todo "brain-rc not running (start: brain)"
  fi
  if tmux has-session -t brain-multi 2>/dev/null; then
    ok "brain-multi running (attach: brain multi)"
  fi
}

# ------------------------------------------------------------ headless auth
# Runs an OAuth login inside a detached tmux pane so it can be driven from a
# Claude session (or over plain ssh): 'start' launches it and prints the URL,
# 'paste' feeds the callback URL back to it, 'check' reports the outcome.

vendor_login_flags() {
  case "$1" in
    chatgpt) echo "--codex-device-login" ;;
    grok)    echo "--xai-login --no-browser" ;;
    kimi)    echo "--kimi-login --no-browser" ;;
    claude)  echo "--claude-login --no-browser" ;;
    *)       return 1 ;;
  esac
}

vendor_record_prefix() {
  case "$1" in
    chatgpt) echo codex ;;
    grok)    echo xai ;;
    kimi)    echo kimi ;;
    claude)  echo claude ;;
    *)       return 1 ;;
  esac
}

vendor_linked() {
  local prefix f
  prefix="$(vendor_record_prefix "$1")" || return 1
  for f in "$BRAIN_AUTH_DIR/$prefix"-*.json; do
    [ -e "$f" ] && return 0
  done
  return 1
}

cmd_auth_start() {
  local vendor="$1" flags log
  flags="$(vendor_login_flags "$vendor")" || die "unknown vendor: $vendor"
  [ -x "$BRAIN_PROXY_BIN" ] || die "proxy not built — run: brain setup"
  need tmux
  log="$BRAIN_STATE_DIR/auth-$vendor.log"
  mkdir -p "$BRAIN_STATE_DIR"
  rm -f "$log"
  tmux kill-session -t "auth-$vendor" 2>/dev/null || true
  # Brief sleep so pipe-pane attaches before the login prints its URL.
  # shellcheck disable=SC2086  # flags are intentionally word-split
  tmux new-session -d -s "auth-$vendor" \
    "sleep 1; $BRAIN_PROXY_BIN --config $BRAIN_PROXY_CONFIG $flags"
  tmux pipe-pane -t "auth-$vendor" -o "cat >> $log"

  local i url=""
  for i in $(seq 1 30); do
    sleep 1
    url="$(grep -oE 'https://[^[:space:]]+' "$log" 2>/dev/null | head -1 || true)"
    [ -n "$url" ] && break
    tmux has-session -t "auth-$vendor" 2>/dev/null || break
  done
  if [ -z "$url" ]; then
    fail "no login URL appeared after ${i}s — output so far:"
    cat "$log" >&2 2>/dev/null || true
    exit 1
  fi

  info "open this link in any browser and approve:"
  printf '\n  %s\n\n' "$url"
  if [ "$vendor" = chatgpt ] || printf '%s' "$url" | grep -qi device; then
    # Device-style flow: completes on its own once approved.
    grep -oE '[A-Z0-9]{4,}-[A-Z0-9]{4,}' "$log" | head -1 \
      | sed 's/^/  device code: /' || true
    info "then run: brain auth check $vendor"
  else
    info "after approving, the browser lands on a localhost address that won't load —"
    info "copy that address and run: brain auth paste $vendor '<that-url>'"
  fi
}

cmd_auth_paste() {
  local vendor="$1" url="${2:-}"
  [ -n "$url" ] || die "usage: brain auth paste <vendor> '<callback-url>'"
  tmux has-session -t "auth-$vendor" 2>/dev/null \
    || die "no login in progress for $vendor — run: brain auth start $vendor"
  tmux send-keys -t "auth-$vendor" -l "$url"
  tmux send-keys -t "auth-$vendor" Enter
  sleep 3
  cmd_auth_check "$vendor"
}

cmd_auth_check() {
  local vendor="$1"
  chmod 700 "$BRAIN_AUTH_DIR" 2>/dev/null || true
  chmod 600 "$BRAIN_AUTH_DIR"/*.json 2>/dev/null || true
  if vendor_linked "$vendor"; then
    tmux kill-session -t "auth-$vendor" 2>/dev/null || true
    ok "$vendor linked"
  elif tmux has-session -t "auth-$vendor" 2>/dev/null; then
    warn "$vendor login still in progress — recent output:"
    tail -5 "$BRAIN_STATE_DIR/auth-$vendor.log" 2>/dev/null >&2 || true
    exit 1
  else
    fail "$vendor login ended without a credential — output:"
    tail -15 "$BRAIN_STATE_DIR/auth-$vendor.log" 2>/dev/null >&2 || true
    exit 1
  fi
}

# --------------------------------------------------------------------- auth
cmd_auth() {
  local vendor="${1:-}"
  case "$vendor" in
    start) shift; cmd_auth_start "${1:?usage: brain auth start <chatgpt|grok|kimi|claude>}"; return ;;
    paste) shift; cmd_auth_paste "${1:?vendor required}" "${2:-}"; return ;;
    check) shift; cmd_auth_check "${1:?vendor required}"; return ;;
  esac
  case "$vendor" in
    anthropic)
      claude_bin >/dev/null || die "claude not installed — run: brain setup"
      info "launching claude — follow the login prompts, open the URL on your"
      info "laptop or phone, paste the code back here, then /exit"
      env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_API_KEY "$(claude_bin)"
      ;;
    chatgpt)
      [ -x "$BRAIN_PROXY_BIN" ] || die "proxy not built — run: brain setup"
      if [ "${2:-}" = "--browser" ]; then
        # Browser OAuth whose callback lands on localhost:1455 of the machine
        # running THIS command. Run it from your laptop with the port forwarded:
        #   ssh -t -L 1455:localhost:1455 claude-brain 'bash -lc "brain auth chatgpt --browser"'
        if [ -z "${SSH_CONNECTION:-}" ] || ! port_listening 1455; then
          warn "reminder: this only works when localhost:1455 is forwarded from the"
          warn "machine whose browser you'll use, e.g. from your laptop:"
          warn "  ssh -t -L 1455:localhost:1455 claude-brain 'bash -lc \"brain auth chatgpt --browser\"'"
        fi
        "$BRAIN_PROXY_BIN" --config "$BRAIN_PROXY_CONFIG" --codex-login --no-browser
      else
        info "ChatGPT device login: you'll get a URL + code to enter on any browser"
        info "(if ChatGPT refuses device codes, use: brain auth chatgpt --browser)"
        "$BRAIN_PROXY_BIN" --config "$BRAIN_PROXY_CONFIG" --codex-device-login
      fi
      ;;
    grok)
      [ -x "$BRAIN_PROXY_BIN" ] || die "proxy not built — run: brain setup"
      info "Grok login: open the printed URL in your laptop browser"
      "$BRAIN_PROXY_BIN" --config "$BRAIN_PROXY_CONFIG" --xai-login --no-browser
      ;;
    kimi)
      [ -x "$BRAIN_PROXY_BIN" ] || die "proxy not built — run: brain setup"
      info "Kimi login: open the printed URL in your laptop browser"
      "$BRAIN_PROXY_BIN" --config "$BRAIN_PROXY_CONFIG" --kimi-login --no-browser
      ;;
    claude)
      [ -x "$BRAIN_PROXY_BIN" ] || die "proxy not built — run: brain setup"
      warn "this login's callback lands on localhost:54545 on THIS machine."
      warn "First reconnect with:  ssh -L 54545:localhost:54545 claude-brain"
      warn "(only needed for Claude models inside 'brain multi' — your main"
      warn "session already has its own Claude login)"
      "$BRAIN_PROXY_BIN" --config "$BRAIN_PROXY_CONFIG" --claude-login --no-browser
      ;;
    github)
      need gh
      gh auth login --git-protocol https
      gh auth setup-git
      ;;
    tailscale)
      if ! command -v tailscale >/dev/null 2>&1; then
        info "installing Tailscale"
        curl -fsSL https://tailscale.com/install.sh | sudo sh
      fi
      info "open the URL below on your phone/laptop and approve this machine"
      info "(install the Tailscale app on your phone first: tailscale.com/download)"
      sudo tailscale up --timeout 240s
      # The droplet runs a default-deny firewall we installed, so tailnet
      # traffic needs an explicit hole. We never touch a personal machine's
      # firewall — that is the owner's business.
      if [ "$(setting_get PROFILE "$(default_profile)")" = droplet ] && command -v ufw >/dev/null 2>&1; then
        sudo ufw allow in on tailscale0 >/dev/null 2>&1 || true
      fi
      ok "joined tailnet as: $("$(tailscale_bin)" status --json | jq -r '.Self.DNSName' | sed 's/\.$//')"
      ;;
    *)
      die "usage: brain auth <anthropic|chatgpt|grok|kimi|claude|github|tailscale>"
      ;;
  esac
  # OAuth tools may write loose perms; re-tighten.
  chmod 700 "$BRAIN_AUTH_DIR" 2>/dev/null || true
  chmod 600 "$BRAIN_AUTH_DIR"/*.json 2>/dev/null || true
}

# -------------------------------------------------------------------- setup
render_proxy_config() {
  umask 077
  sed -e "s|__TOKEN__|$(brain_token)|" -e "s|__AUTH_DIR__|$BRAIN_AUTH_DIR|" \
    "$BRAIN_REPO_DIR/host/templates/proxy-config.yaml.tmpl" > "$BRAIN_PROXY_CONFIG"
  chmod 600 "$BRAIN_PROXY_CONFIG"
}

install_unit() {
  svc_install proxy
}

ask_yn() {
  local prompt="$1" reply
  read -r -p "$prompt [Y/n] " reply </dev/tty || reply=""
  case "$reply" in n|N|no|NO) return 1 ;; *) return 0 ;; esac
}

# ask_default PROMPT DEFAULT — free-text question with an Enter-accepts default.
ask_default() {
  local reply
  read -r -p "$1 [$2]: " reply </dev/tty || reply=""
  printf '%s' "${reply:-$2}"
}

# Non-interactive answers so a Claude session (or a script) can drive setup:
#   brain setup --yes --scope workspace --workspace ~/brain --link chatgpt,github
BRAIN_SETUP_YES=0
BRAIN_SETUP_LINK=""
BRAIN_SETUP_SCOPE=""
BRAIN_SETUP_WS=""
BRAIN_SETUP_AUTOSTART=0

# Ask a yes/no question, unless --yes already answered it.
setup_yn() {
  [ "$BRAIN_SETUP_YES" -eq 1 ] && return 0
  ask_yn "$1"
}

# True when a vendor was requested with --link (or nothing was: ask about all).
setup_wants() {
  [ -z "$BRAIN_SETUP_LINK" ] && return 1
  case ",$BRAIN_SETUP_LINK," in *",$1,"*) return 0 ;; *) return 1 ;; esac
}

# Should we offer this vendor at all? With --link, only the listed ones. With
# --yes and no --link, none: "yes to everything" must not mean "start an OAuth
# flow nobody is watching" — an unattended caller links accounts afterwards
# with `brain auth start <vendor>`.
setup_offer() {
  if [ -n "$BRAIN_SETUP_LINK" ]; then setup_wants "$1"; return $?; fi
  [ "$BRAIN_SETUP_YES" -eq 1 ] && return 1
  return 0
}

cmd_setup() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y)     BRAIN_SETUP_YES=1; shift ;;
      --link)       BRAIN_SETUP_LINK="${2:?}"; shift 2 ;;
      --scope)      BRAIN_SETUP_SCOPE="${2:?}"; shift 2 ;;
      --workspace)  BRAIN_SETUP_WS="${2:?}"; shift 2 ;;
      --autostart)  BRAIN_SETUP_AUTOSTART=1; shift ;;
      *) die "usage: brain setup [--yes] [--scope machine|workspace] [--workspace DIR] [--link chatgpt,grok,kimi,github] [--autostart]" ;;
    esac
  done

  printf '%s\n\n' "${C_BOLD}Welcome to claude-brain setup!${C_RESET} (safe to re-run any time)"
  ensure_brain_dirs

  # 0. what kind of machine is this, and how much of it does the brain get?
  local profile
  profile="$(setting_get PROFILE "$(default_profile)")"
  setting_set PROFILE "$profile"
  info "step 0/7: this machine — $(brain_distro) · $(brain_os)/$(brain_arch) · profile=$profile"
  if [ "$profile" = local ]; then
    # On a droplet this question is meaningless: the machine exists only for
    # the brain. On someone's own computer it is the important one.
    local scope="${BRAIN_SETUP_SCOPE:-}"
    if [ -z "$scope" ]; then
      if [ "$BRAIN_SETUP_YES" -eq 1 ]; then
        scope="$(setting_get SCOPE workspace)"
      else
        printf '  This is your own computer. How much of it should your brain use?\n'
        printf '    1) its own folder — it works in one directory and asks before going outside\n'
        printf '    2) the whole machine — like the cloud version: it administers this computer\n'
        local reply
        read -r -p "  Choose [1/2, default 1]: " reply </dev/tty || reply=""
        case "$reply" in 2) scope=machine ;; *) scope=workspace ;; esac
      fi
    fi
    setting_set SCOPE "$scope"
    if [ "$scope" = workspace ]; then
      local ws="${BRAIN_SETUP_WS:-}"
      if [ -z "$ws" ]; then
        if [ "$BRAIN_SETUP_YES" -eq 1 ]; then
          ws="$(setting_get WORKSPACE_DIR "$HOME/brain-workspace")"
        else
          ws="$(ask_default "  Working folder" "$HOME/brain-workspace")"
        fi
      fi
      setting_set WORKSPACE_DIR "$ws"
      mkdir -p "$ws"
      step_done "workspace: $ws"
    else
      step_done "scope: the whole machine"
    fi
  else
    setting_set SCOPE machine
  fi

  # 1. bootstrap artifacts
  info "step 1/7: checking the machine"
  go_path_hint
  need git tmux jq curl openssl go
  claude_bin >/dev/null || {
    info "installing Claude Code"
    curl -fsSL https://claude.ai/install.sh | bash
    export PATH="$HOME/.local/bin:$PATH"
  }
  if [ -x "$BRAIN_PROXY_BIN" ]; then
    step_done "proxy binary built"
  else
    if [ -f "$BRAIN_STATE_DIR/proxy-build.log" ] && pgrep -f brain-proxy-build >/dev/null 2>&1; then
      info "background proxy build still running — waiting (log: $BRAIN_STATE_DIR/proxy-build.log)"
      while pgrep -f brain-proxy-build >/dev/null 2>&1; do sleep 5; printf '.'; done
      echo
    fi
    [ -x "$BRAIN_PROXY_BIN" ] || "$SCRIPT_DIR/brain-proxy-build"
  fi

  # 2. Claude login (the core product)
  info "step 2/7: sign in to Claude (your main brain)"
  if [ -e "$HOME/.claude/.credentials.json" ] || grep -q oauthAccount "$HOME/.claude.json" 2>/dev/null; then
    step_done "claude login already present"
  elif [ "$BRAIN_SETUP_YES" -eq 1 ] || [ ! -t 0 ]; then
    # The Claude login is interactive by nature. Unattended runs must not launch
    # it into a terminal nobody is watching; they say what is still missing.
    warn "no Claude login yet — sign in with: brain auth anthropic"
  else
    cmd_auth anthropic
  fi

  # 3. proxy config + token
  info "step 3/7: configuring the model router"
  if [ -f "$BRAIN_PROXY_CONFIG" ]; then
    step_done "router config exists"
  else
    render_proxy_config
    step_done "router config written"
  fi

  # 4. systemd service
  info "step 4/7: starting the router service"
  if svc_is_active proxy; then
    step_done "router already running"
  else
    install_unit
    sleep 2
  fi
  proxy_ready && ok "router healthy" || warn "router not answering yet — check 'brain status' in a minute"

  # 5. vendor logins
  info "step 5/7: link your other AI accounts (each optional — Enter to accept, n to skip)"
  if vendor_linked chatgpt; then step_done "ChatGPT linked"; else
    if setup_offer chatgpt && setup_yn "  Link a ChatGPT account (for GPT models)?"; then cmd_auth chatgpt || warn "ChatGPT login didn't finish — retry later: brain auth chatgpt"; fi
  fi
  if vendor_linked grok; then step_done "Grok linked"; else
    if setup_offer grok && setup_yn "  Link a Grok (X.AI) account?"; then cmd_auth grok || warn "Grok login didn't finish — retry later: brain auth grok"; fi
  fi
  if vendor_linked kimi; then step_done "Kimi linked"; else
    if setup_offer kimi && setup_yn "  Link a Kimi account?"; then cmd_auth kimi || warn "Kimi login didn't finish — retry later: brain auth kimi"; fi
  fi

  # 6. GitHub
  info "step 6/7: connect GitHub (so your brain can work on your repos)"
  if gh auth status >/dev/null 2>&1; then
    step_done "github linked"
  elif setup_offer github; then
    setup_yn "  Log in to GitHub now?" && cmd_auth github || true
  fi
  if [ -z "$(git config --global user.email 2>/dev/null)" ] && [ "$BRAIN_SETUP_YES" -eq 0 ]; then
    local gname gemail
    read -r -p "  Your name for git commits: " gname </dev/tty || gname=""
    read -r -p "  Your email for git commits: " gemail </dev/tty || gemail=""
    [ -n "$gname" ] && git config --global user.name "$gname"
    [ -n "$gemail" ] && git config --global user.email "$gemail"
  fi

  # optional features (default off — Enter leaves them off)
  local compress_toml="$BRAIN_STATE_DIR/compress/compress.toml"
  if grep -Eqs '^ *enabled *= *true' <(sed -n '/^\[recall\]/,/^\[/p' "$compress_toml" 2>/dev/null); then
    step_done "session recall enabled"
  elif [ "$BRAIN_SETUP_YES" -eq 1 ] || [ ! -t 0 ]; then
    # Unattended: leave the privacy-sensitive default alone rather than
    # answering a question about the user's past transcripts for them.
    info "  session recall left off (enable later: add [recall] enabled = true to $compress_toml)"
  else
    local reply=""
    printf '  Enable session recall? It lets the brain search your PAST Claude Code\n'
    printf '  session transcripts (which can contain sensitive text) for old commands\n'
    printf '  and decisions. Off by default; recalled text is redacted on print.\n'
    read -r -p "  Enable session recall? [y/N] " reply </dev/tty || reply=""
    case "$reply" in
      y|Y|yes|YES)
        mkdir -p "$(dirname "$compress_toml")"
        printf '\n[recall]\nenabled = true\n' >> "$compress_toml"
        step_done "session recall enabled (brain recall \"query\")"
        ;;
      *) info "  session recall left off (enable later: add [recall] enabled = true to $compress_toml)" ;;
    esac
  fi


  # 7. always on
  info "step 7/7: wiring Claude Code, and staying available"
  # Install the RC lane's agents and this machine's CLAUDE.md blocks now rather
  # than at first session: the ops block is what tells the brain its scope and
  # whether sudo will prompt, and an unattended install would otherwise leave
  # the machine without those rules until someone ran `brain` by hand.
  install_agents "$AGENTS_RC_SRC"
  install_routing "$BRAIN_REPO_DIR/host/claude/routing-rc.md"
  step_done "consultant agents + routing installed"
  if svc_is_active rc; then
    step_done "autostart already on"
  elif [ "$BRAIN_SETUP_AUTOSTART" -eq 1 ] ||
       { [ "$BRAIN_SETUP_YES" -eq 0 ] && ask_yn "  Start your brain automatically after a reboot?"; }; then
    # Under --yes this is opt-in via --autostart, not implied: the plan the
    # caller was shown said "autostart: no", and the plan is what happens.
    autostart_enable && ok "autostart enabled" || warn "could not enable autostart"
    autostart_status | tail -n +2 | sed 's/^/    /'
  fi
  if [ "$(brain_os)" = macos ] || [ "$(setting_get PROFILE "$(default_profile)")" = local ]; then
    printf '    %s\n' "$(keepawake_status)"
    printf '    %s\n' "(a sleeping computer cannot be reached — 'brain keepawake' fixes that)"
  fi

  printf '\n%s\n' "${C_BOLD}All set. Your everyday commands:${C_RESET}"
  cat <<'CHEAT'
    brain            start/attach your main session — it appears in the Claude app
    brain status     is everything healthy?
    brain autostart  come back automatically after a reboot
    brain multi      power mode: other models drive natively (no phone control)
    brain auth X     redo any login (anthropic|chatgpt|grok|kimi|github)
    brain update     get the latest claude-brain
    brain uninstall  remove claude-brain and restore your Claude Code config
    brain explore "question"   cheap-model repo navigation (discovery only)

CHEAT
  if [ -t 0 ] && setup_yn "Start your brain session now?"; then
    cmd_rc
  elif [ "$BRAIN_SETUP_YES" -eq 1 ]; then
    info "start it whenever you like with: brain"
  fi
}

# ---------------------------------------------------------------- always-on
# Two different promises: autostart is "the brain comes back after a reboot",
# keepawake is "the machine is awake to be reached at all". Only the second
# changes system-wide settings, so only it asks first.
cmd_autostart() {
  case "${1:-status}" in
    enable)
      autostart_enable
      ok "autostart enabled"
      autostart_status | tail -n +2 | sed 's/^/    /'
      ;;
    disable)
      autostart_disable
      ok "autostart disabled — start your brain by hand with: brain"
      ;;
    status)
      autostart_status
      ;;
    *)
      die "usage: brain autostart [enable|disable|status]"
      ;;
  esac
}

cmd_keepawake() {
  local cmds
  cmds="$(keepawake_cmds)"
  if [ "${1:-}" = "status" ]; then keepawake_status; return; fi
  if [ -z "$cmds" ]; then
    warn "no keep-awake settings to change on this platform"
    return
  fi
  info "current: $(keepawake_status)"
  info "this will change a system setting on this computer:"
  printf '%s\n' "$cmds" | sed 's/^/    /'
  if [ "${1:-}" = "--yes" ] || ask_yn "Apply it?"; then
    printf '%s\n' "$cmds" | while IFS= read -r c; do
      [ -n "$c" ] || continue
      eval "$c"
    done
    ok "$(keepawake_status)"
  else
    info "left unchanged"
  fi
}

# ------------------------------------------------------------------- expose
# Share a local dev server: private HTTPS on the tailnet by default, public
# via Tailscale Funnel with --public. Never opens firewall ports.
cmd_expose() {
  local arg="${1:-}" public=0
  [ "${2:-}" = "--public" ] && public=1
  local ts
  ts="$(tailscale_bin)" || die "Tailscale isn't set up — run: brain auth tailscale"
  "$ts" status >/dev/null 2>&1 || die "Tailscale is not connected — run: brain auth tailscale"
  case "$arg" in
    off)
      sudo "$ts" serve reset
      sudo "$ts" funnel reset 2>/dev/null || true
      ok "nothing is exposed any more"
      ;;
    ''|*[!0-9]*)
      die "usage: brain expose <port> [--public] | brain expose off"
      ;;
    *)
      local host
      host="$("$ts" status --json | jq -r '.Self.DNSName' | sed 's/\.$//')"
      if [ "$public" -eq 1 ]; then
        sudo "$ts" funnel --bg "$arg" >/dev/null
        ok "PUBLIC (anyone with the link): https://$host/"
        warn "this is on the open internet — run 'brain expose off' when done"
      else
        sudo "$ts" serve --bg "$arg" >/dev/null
        ok "private (your tailnet devices only): https://$host/"
      fi
      ;;
  esac
}

# ----------------------------------------------------------------- compress
# Token accounting + artifact recovery (Stage 1: observe-only). Thin passthrough
# to the native brain-compress binary; the launcher reports clearly if it isn't
# installed yet.
cmd_compress() {
  local launcher
  launcher="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/brain-compress"
  exec "$launcher" compress "$@"
}

# Cheap-model repository navigation (discovery only — output is never an edit
# source). One dense cited block from a cheap model instead of the main model
# reading files itself.
cmd_explore() {
  local launcher
  launcher="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/brain-compress"
  exec "$launcher" explore "$@"
}

# Session-history recall (OPT-IN, off by default — see brain setup). Recalled
# text is untrusted data and is redacted on print.
cmd_recall() {
  local launcher
  launcher="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/brain-compress"
  exec "$launcher" recall "$@"
}

# ------------------------------------------------------------------- config
# Live consultation progress. Shared by the progress hook, the statusline, and
# anyone tailing by hand, so all three report identical state.
cmd_consult() {
  local think
  case "${1:-status}" in
    status)
      if line="$(consult_progress_line)"; then
        printf '%s\n' "$line"
      else
        printf 'idle\n'
      fi
      ;;
    log)
      [ -e "$BRAIN_CONSULT_LINK" ] || die "no consultation has run yet"
      readlink -f "$BRAIN_CONSULT_LINK"
      ;;
    watch)
      [ -e "$BRAIN_CONSULT_LINK" ] || die "no consultation has run yet"
      tail -f "$(readlink -f "$BRAIN_CONSULT_LINK")"
      ;;
    think)
      [ -e "$BRAIN_CONSULT_LINK" ] || die "no consultation has run yet"
      think="$(readlink -f "$BRAIN_CONSULT_LINK").thinking"
      [ -f "$think" ] || die "no reasoning captured for this consultation"
      tail -f "$think"
      ;;
    *)
      die "usage: brain consult [status|log|watch|think]"
      ;;
  esac
}

cmd_config() {
  local key="${1:-}" val="${2:-}"
  case "$key" in
    '')
      printf '%s\n' "${C_BOLD}brain settings${C_RESET}"
      printf '  consult    = %s   (brain config consult <foreground|background>)\n' \
        "$(setting_get CONSULT_VISIBILITY background)"
      printf '  profile    = %s   (set at install time)\n' "$(setting_get PROFILE "$(default_profile)")"
      printf '  scope      = %s   (brain config scope <machine|workspace>)\n' "$(setting_get SCOPE machine)"
      printf '  workspace  = %s\n' "$(workspace_dir)"
      ;;
    statusline)
      command -v jq >/dev/null 2>&1 || die "jq is required to change the statusline"
      local settings="$HOME/.claude/settings.json"
      [ -s "$settings" ] || echo '{}' > "$settings"
      case "$val" in
        on)
          jq --arg c "$BRAIN_REPO_DIR/host/claude/statusline.sh" \
             '.statusLine = {type: "command", command: $c, refreshInterval: 2}' \
             "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"
          ok "claude-brain statusline enabled (new sessions pick it up)"
          ;;
        off)
          jq 'if ((.statusLine.command // "") | test("claude-brain|statusline.sh")) then del(.statusLine) else . end' \
             "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"
          ok "claude-brain statusline removed"
          ;;
        *)
          jq -r '.statusLine.command // "none"' "$settings"
          ;;
      esac
      ;;
    consult)
      case "$val" in
        '')
          printf '%s\n' "$(setting_get CONSULT_VISIBILITY background)"
          ;;
        foreground|background)
          setting_set CONSULT_VISIBILITY "$val"
          install_consult_block
          ok "brain-* consultants now run in the $val by default"
          info "applies to new Claude sessions (and the current one after a restart)"
          ;;
        *)
          die "usage: brain config consult [foreground|background]"
          ;;
      esac
      ;;
    scope)
      case "$val" in
        '') setting_get SCOPE machine ;;
        machine|workspace)
          setting_set SCOPE "$val"
          [ "$val" = workspace ] && [ -n "${3:-}" ] && setting_set WORKSPACE_DIR "$3"
          install_ops_block
          ok "scope is now $val (working root: $(workspace_dir))"
          info "applies to new Claude sessions"
          ;;
        *) die "usage: brain config scope <machine|workspace> [workspace-dir]" ;;
      esac
      ;;
    *)
      die "usage: brain config [consult <foreground|background>|scope <machine|workspace>|statusline <on|off>]"
      ;;
  esac
}

# ------------------------------------------------------------------- update
cmd_update() {
  info "updating claude-brain"
  git -C "$BRAIN_REPO_DIR" pull --ff-only
  "$BRAIN_REPO_DIR/host/install.sh"
  "$SCRIPT_DIR/brain-proxy-build"   # no-op unless PIN changed
  if claude_bin >/dev/null; then "$(claude_bin)" update || true; fi
  if [ -f "$BRAIN_PROXY_CONFIG" ]; then
    svc_install proxy
    svc_restart proxy
  fi
  ok "updated"
}

# ---------------------------------------------------------------- uninstall
# The counterweight to installing on a machine someone actually uses: put their
# Claude Code config back, stop our services, and leave their repos alone.
cmd_uninstall() {
  local purge=0
  [ "${1:-}" = "--purge" ] && purge=1

  info "this will remove claude-brain from this machine:"
  printf '    stop and remove the router%s service(s)\n' "$([ "$(brain_os)" = macos ] && echo " (launchd)" || echo " (systemd)")"
  printf '    remove the brain commands from ~/.local/bin\n'
  printf '    remove claude-brain hooks, agents and CLAUDE.md blocks from ~/.claude\n'
  if [ "$purge" -eq 1 ]; then
    printf '    %s\n' "${C_RED}delete all brain state AND your linked account credentials${C_RESET}"
  else
    printf '    keep your state and linked accounts (add --purge to delete those too)\n'
  fi
  printf '    keep the claude-brain checkout at %s\n' "$BRAIN_REPO_DIR"
  ask_yn "Go ahead?" || { info "nothing changed"; return 0; }

  svc_uninstall rc
  svc_uninstall proxy

  local tool
  for tool in brain-ask brain-compress brain-proxy-build; do
    rm -f "$HOME/.local/bin/$tool"
  done

  local name
  for name in "${ALL_BRAIN_AGENTS[@]}"; do
    rm -f "$AGENTS_DIR/$name.md"
  done
  remove_block routing
  remove_block ops
  remove_block consult

  # Un-register the hooks and hand the statusline back.
  local settings="$HOME/.claude/settings.json" backup="$BRAIN_STATE_DIR/settings.json.pre-brain"
  if command -v jq >/dev/null 2>&1 && [ -s "$settings" ]; then
    local prior=""
    [ -f "$backup" ] && prior="$(jq -r '.statusLine.command // empty' "$backup" 2>/dev/null || true)"
    jq --arg managed 'model-guard|consult-poll-guard|consult-progress|brain-compress-bash|brain-compress-read' \
       --arg prior "$prior" '
      def strip(list): [list[]? | select((.hooks[]?.command // "") | test($managed) | not)];
      .hooks.PreToolUse = strip(.hooks.PreToolUse)
      | .hooks.PostToolUse = strip(.hooks.PostToolUse)
      | if ((.statusLine.command // "") | test("claude-brain|/host/claude/statusline.sh|/droplet/claude/statusline.sh"))
        then (if $prior == "" then del(.statusLine)
              else .statusLine = {type: "command", command: $prior, refreshInterval: 2} end)
        else . end
    ' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"
    ok "restored ~/.claude/settings.json (backup kept at $backup)"
  fi

  if [ "$purge" -eq 1 ]; then
    warn "deleting state and credentials"
    rm -rf "$BRAIN_CONFIG_DIR" "$BRAIN_DATA_DIR" "$BRAIN_STATE_DIR" "$BRAIN_AUTH_DIR"
  fi

  rm -f "$HOME/.local/bin/brain"
  ok "claude-brain removed"
  info "the checkout is still at $BRAIN_REPO_DIR — delete it if you want it gone"
  info "your PATH line in ~/.bashrc / ~/.zshrc is harmless, but you can remove it"
}

# ----------------------------------------------------------------- dispatch
case "${1:-rc}" in
  rc|"")     cmd_rc ;;
  multi)     cmd_multi ;;
  status)    cmd_status ;;
  expose)    shift; cmd_expose "$@" ;;
  autostart) shift; cmd_autostart "$@" ;;
  keepawake) shift; cmd_keepawake "$@" ;;
  repo)      shift; cmd_repo "$@" ;;
  auth)      shift; cmd_auth "$@" ;;
  setup)     shift; cmd_setup "$@" ;;
  consult)   shift; cmd_consult "$@" ;;
  compress)  shift; cmd_compress "$@" ;;
  explore)   shift; cmd_explore "$@" ;;
  recall)    shift; cmd_recall "$@" ;;
  config)    shift; cmd_config "$@" ;;
  update)    cmd_update ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  help|-h|--help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)         die "unknown command: $1 (try: brain help)" ;;
esac
